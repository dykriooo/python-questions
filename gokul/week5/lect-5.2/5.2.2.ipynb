   "source": [
    "l=[1,4,2,5,3]\n",
    "\n",
    "def minimum(l):\n",
    "    return min(l)\n",
    "\n",
    "def maximum(l):\n",
    "    return max(l)\n",
    "\n",
    "# ascending order\n",
    "\n",
    "def ascending_order(l):\n",
    "    op=[]\n",
    "    while l:\n",
    "        minimum_elem=minimum(l)\n",
    "        op.append(minimum_elem)\n",
    "        l.remove(minimum_elem)\n",
    "    print(op)\n",
    "\n",
    "ascending_order(l)\n"
   ]
  },
